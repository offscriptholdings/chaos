        {
            "parameters": {
                "jsCode": "// Pre-filter: narrow universe to viable candidates before indicator calls\nconst tickers = $input.item.json.tickers || [];\n\nconst candidates = tickers.filter(t => {\n  const price = t.day?.c || 0;\n  const volume = t.day?.v || 0;\n  const prevClose = t.prevDay?.c || 0;\n  const changePercent = t.todaysChangePerc || 0;\n\n  return (\n    price >= 15 &&\n    price <= 500 &&\n    volume >= 500000 &&\n    prevClose > 0\n  );\n}).slice(0, 100); // Cap at 100 to manage API calls\n\nreturn candidates.map(t => ({\n  json: {\n    ticker: t.ticker,\n    price: t.day?.c,\n    open: t.day?.o,\n    high: t.day?.h,\n    low: t.day?.l,\n    volume: t.day?.v,\n    vwap: t.day?.vw,\n    prevClose: t.prevDay?.c,\n    change_pct: t.todaysChangePerc\n  }\n}));"
            },
