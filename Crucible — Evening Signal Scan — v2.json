                    "mode": "runOnceForEachItem",
                    "jsCode": "const base = $('Pre-Filter Candidates').item.json;\nconst rsiData = $('Polygon \u2014 RSI').item.json.results?.values || [];\nconst macdData = $('Polygon \u2014 MACD').item.json.results?.values || [];\nconst ema200Data = $('Polygon \u2014 EMA 200').item.json.results?.values || [];\nconst ema50Data = $('Polygon \u2014 EMA 50').item.json.results?.values || [];\n\nconst rsi = rsiData[0]?.value || null;\nconst macdHistogram = macdData[0]?.histogram || null;\nconst macdHistogramPrev = macdData[1]?.histogram || null;\nconst macdValue = macdData[0]?.value || null;\nconst ema200 = ema200Data[0]?.value || null;\nconst ema50 = ema50Data[0]?.value || null;\n\nconst price = base.price;\nconst volume = base.volume;\nconst vwap = base.vwap;\nconst high = base.high;\nconst low = base.low;\nconst changePct = base.change_pct;\n\nconst isS1 = Boolean(\n  ema200 && price > ema200 &&\n  rsi && rsi >= 40 && rsi <= 55 &&\n  macdValue && macdValue > 0 &&\n  changePct >= -3 && changePct <= 2 &&\n  price > vwap\n);\n\nconst dayRange = high - low;\nconst closeVsHighPct = dayRange > 0 ? (price - low) / dayRange : 0;\nconst isS2 = Boolean(\n  ema200 && price > ema200 &&\n  changePct >= 2 && changePct <= 15 &&\n  closeVsHighPct >= 0.7 &&\n  volume >= 1000000\n);\n\nconst macdCrossed = Boolean(macdHistogram > 0 && macdHistogramPrev !== null && macdHistogramPrev <= 0);\nconst nearEma50 = Boolean(ema50 && Math.abs(price - ema50) / ema50 < 0.05);\nconst nearEma200 = Boolean(ema200 && Math.abs(price - ema200) / ema200 < 0.05);\nconst isS3 = Boolean(\n  rsi && rsi >= 35 && rsi <= 50 &&\n  macdCrossed &&\n  (nearEma50 || nearEma200) &&\n  volume >= 500000\n);\n\nlet setup_type = null;\nlet entry_zone = null;\nlet stop = null;\nlet target = null;\n\nif (isS3) {\n  setup_type = 'S3';\n  entry_zone = parseFloat(price.toFixed(2));\n  stop = parseFloat((ema50 ? ema50 * 0.97 : price * 0.95).toFixed(2));\n  target = parseFloat((ema200 ? ema200 * 1.02 : price * 1.06).toFixed(2));\n} else if (isS2) {\n  setup_type = 'S2';\n  entry_zone = parseFloat(price.toFixed(2));\n  stop = parseFloat((low * 0.99).toFixed(2));\n  target = parseFloat((price * 1.10).toFixed(2));\n} else if (isS1) {\n  setup_type = 'S1';\n  entry_zone = parseFloat((price * 0.99).toFixed(2));\n  stop = parseFloat((ema200 * 0.98).toFixed(2));\n  target = parseFloat((price * 1.08).toFixed(2));\n}\n\nreturn {\n  ticker: base.ticker,\n  is_signal: setup_type !== null,\n  setup_type: setup_type,\n  price_data: {\n    close: price,\n    volume: volume,\n    vwap: vwap,\n    rsi: rsi,\n    macd_histogram: macdHistogram,\n    ema200: ema200,\n    ema50: ema50,\n    change_pct: changePct\n  },\n  entry_zone: entry_zone,\n  stop: stop,\n  target: target\n};"
                },
