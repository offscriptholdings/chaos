                "url": "=https://api.polygon.io/v1/indicators/ema/{{ $('Pre-Filter Candidates').item.json.ticker }}?timespan=day&adjusted=true&window=50&series_type=close&order=desc&limit=1&apiKey=L8wCDo8xEcU_Pw_Dc5c8JrpdeGzFBtS7",
