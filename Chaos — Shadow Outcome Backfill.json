      },
      "id": "a1111111-1111-1111-1111-111111111111",
      "name": "Daily 5pm Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -2160,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = new Date();\nd.setDate(d.getDate() - 14);\nconst cutoffDate = d.toISOString().split('T')[0];\nconst today = new Date().toISOString().split('T')[0];\nreturn [{ json: { cutoffDate, today } }];"
      },
      "id": "a2222222-2222-2222-2222-222222222222",
      "name": "Compute Cutoff",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1920,
        112
      ]
    },
    {
      "parameters": {
        "url": "https://dbnkkournwhgnguugbnq.supabase.co/rest/v1/shadow_trades?select=*,signals!signal_id(ticker,signal_date,entry_mid,stop,r_ratio)&outcome_if_taken=is.null",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept-Profile",
              "value": "chaos"
            }
          ]
        },
        "options": {},
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi"
      },
      "id": "a3333333-3333-3333-3333-333333333333",
      "name": "Query Shadow Trades",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1680,
        112
      ],
      "credentials": {
        "supabaseApi": {
          "id": "IoaagakstuDyI61D",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cutoffDate = $('Compute Cutoff').first().json.cutoffDate;\nconst rows = $input.all();\nconst filtered = rows.filter(r => {\n  const s = r.json.signals;\n  if (!s) return false;\n  if (!s.signal_date || s.signal_date < cutoffDate) return false;\n  if (s.entry_mid == null || s.stop == null || s.r_ratio == null) return false;\n  return true;\n});\nreturn filtered;"
      },
      "id": "a4444444-4444-4444-4444-444444444444",
      "name": "Filter and Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1440,
        112
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "a5555555-5555-5555-5555-555555555555",
      "name": "SplitInBatches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -1200,
        112
      ]
    },
    {
      "parameters": {
        "url": "=https://api.polygon.io/v2/aggs/ticker/{{ $json.signals.ticker }}/range/1/day/{{ $json.signals.signal_date }}/{{ $('Compute Cutoff').first().json.today }}?adjusted=true&sort=asc&apiKey=L8wCDo8xEcU_Pw_Dc5c8JrpdeGzFBtS7",
        "options": {}
      },
      "id": "a6666666-6666-6666-6666-666666666666",
      "name": "Polygon — Daily Bars",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -960,
        112
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const row = $('SplitInBatches').item.json;\nconst s = row.signals;\nconst target = s.entry_mid + (s.entry_mid - s.stop) * s.r_ratio;\nconst barsData = $input.item.json.results ?? [];\n\nlet outcome = null;\nlet would_have_won = null;\n\nif ((s.entry_mid - s.stop) !== 0) {\n  for (const bar of barsData) {\n    if (bar.h >= target) {\n      outcome = s.r_ratio;\n      would_have_won = true;\n      break;\n    }\n    if (bar.l <= s.stop) {\n      outcome = -1.0;\n      would_have_won = false;\n      break;\n    }\n  }\n\n  if (outcome === null && barsData.length >= 10) {\n    const lastClose = barsData[barsData.length - 1].c;\n    outcome = (lastClose - s.entry_mid) / (s.entry_mid - s.stop);\n    would_have_won = outcome > 0;\n  }\n}\n\nreturn [{\n  json: {\n    id: row.id,\n    outcome_if_taken: outcome,\n    would_have_won,\n    should_patch: outcome !== null,\n  }\n}];"
      },
      "id": "a7777777-7777-7777-7777-777777777777",
      "name": "Replay Logic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -720,
        112
      ]
    },
    {
