      "id": "ba7689e2-a6e6-4957-8e3c-43a54d945b45",
      "name": "Polygon — EMA 50",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -720,
        112
